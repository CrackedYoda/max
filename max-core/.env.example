# Runtime
APP_ENV=development            # development | production
HTTP_ADDR=:8080
LOG_LEVEL=debug                # debug | info | warn | error

# Postgres (docker-compose maps to 5433)
DATABASE_URL=postgres://max:max@localhost:5433/max?sslmode=disable

# Wallet challenge domain binding (SIWE domain / URI). Must match the frontend origin.
AUTH_DOMAIN=localhost:3000
AUTH_URI=http://localhost:3000
AUTH_CHALLENGE_TTL=5m
SESSION_TTL=168h
# At least 32 chars. Used to HMAC session tokens.
SESSION_SECRET=change-me-change-me-change-me-change-me
SESSION_COOKIE_SECURE=false

# Comma-separated list of allowed CORS origins. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3000

# Payments
PAYMENT_INTENT_TTL=15m
PAYMENTS_WORKER_ENABLED=true
# JSON-RPC endpoint per chain (RPC_URL_<CHAIN_KEY>). Chains without one refuse payments.
# Public endpoints are rate-limited; use a provider (Helius, Alchemy, QuickNode) for real use.
RPC_URL_SOLANA_DEVNET=https://api.devnet.solana.com
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
# RPC_URL_SOLANA=https://api.mainnet-beta.solana.com
# RPC_URL_ETHEREUM=https://ethereum-rpc.publicnode.com
# RPC_URL_BASE=https://mainnet.base.org
# RPC_URL_ARBITRUM=https://arb1.arbitrum.io/rpc
# RPC_URL_OPTIMISM=https://mainnet.optimism.io
# RPC_URL_POLYGON=https://polygon-rpc.com

# Cross-chain routing (NEAR Intents 1Click). Mainnet chains only.
CROSS_CHAIN_ENABLED=true            # emergency switch for new quotes; in-flight routes are still tracked
NEAR_INTENTS_BASE_URL=https://1click.chaindefuser.com
NEAR_INTENTS_API_KEY=               # partners.near-intents.org; without it 1Click adds a platform fee
CROSS_CHAIN_MAX_USD=1000
CROSS_CHAIN_DEFAULT_SLIPPAGE_BPS=100
CROSS_CHAIN_MAX_SLIPPAGE_BPS=300

# Agents
# HMAC key for agent API key secrets (>= 32 chars, different from SESSION_SECRET).
AGENT_CREDENTIAL_SECRET=change-me-agent-credentials-0123456789
# base64 32-byte ed25519 seed MAX signs agent transfer authorizations with.
# Required in production; generate with: openssl rand -base64 32
AGENT_AUTHZ_SIGNING_SEED=

# Renames (72h cooldown is a fixed product rule)
# Accepted fees, "chain:asset:amount" comma-separated. Only native coins and verified tokens.
# Empty disables renames.
RENAME_FEES=solana-devnet:native:0.05,base-sepolia:0x036CbD53842c5426634e7929541eC2318f3dCF7e:5
RENAME_TREASURY_EVM=0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed
RENAME_TREASURY_SOLANA=9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM
RENAME_QUARANTINE=720h                 # how long a released name stays unclaimable

# X (Twitter) OAuth 2.0 for reserved names. Create an app at developer.x.com
# with OAuth 2.0 enabled, type "Web App" (confidential) and this callback URL.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8080/v1/verifications/x/callback
X_RESULT_REDIRECT=http://localhost:3000/verify/x
X_CLAIM_FRESHNESS=15m        # a claim needs a verification at most this old
X_REVERIFY_INTERVAL=4320h    # 180 days; claims must be re-verified by the same X account
X_REVERIFY_GRACE=336h        # 14 days after that, the ID is locked until re-verified

# Comma-separated account UUIDs allowed to review reserved-name claims and revoke verifications.
ADMIN_ACCOUNT_IDS=
