EXPO_PUBLIC_MAX_API_URL=http://localhost:8080
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Marketplace assets, mirroring max-core MARKET_ASSETS, as chain:mint:decimals.
# The decimals pin is what a market price is converted with before signing (cross-checked on chain).
EXPO_PUBLIC_MARKET_ASSETS=solana-devnet:4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU:6
# Optional treasury pin: max-core TREASURY_SOLANA. When set, a sale whose fee is paid anywhere else
# is refused before signing.
# EXPO_PUBLIC_MARKET_TREASURY=

