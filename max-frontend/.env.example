# max-core API (its CORS_ORIGINS must include this origin).
NEXT_PUBLIC_MAX_API_URL=http://localhost:8080
# Marketplace assets, mirroring max-core MARKET_ASSETS, as chain:mint:decimals (comma-separated).
# The decimals pin is what a market price is converted with before signing (cross-checked on chain).
NEXT_PUBLIC_MARKET_ASSETS=solana:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v:6
# Optional treasury pin: max-core TREASURY_SOLANA. When set, a sale whose fee is paid anywhere else
# is refused before the wallet opens.
# NEXT_PUBLIC_MARKET_TREASURY=

# --- Mainnet profile ---------------------------------------------------------
# NEXT_PUBLIC_MARKET_ASSETS=solana:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v:6
# NEXT_PUBLIC_MARKET_TREASURY=<same as max-core TREASURY_SOLANA>
