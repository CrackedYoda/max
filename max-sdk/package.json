{
  "name": "@max/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for MAX: resolve MAX IDs, send payments, and run policy-bound AI agents.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18.17" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/",
    "test:e2e": "tsc -p tsconfig.test.json && MAX_E2E=1 node --test build-test/test/e2e.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
